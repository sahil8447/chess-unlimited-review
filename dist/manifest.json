
{
  "manifest_version": 3,
  "name": "Chess Unlimited Review",
  "version": "1.4.0",
  "description": "Unlimited completed-game reviews powered by Stockfish 19",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
  {
    "resources": ["pieces/*.svg"],
    "matches": ["https://www.chess.com/*", "https://chess.com/*"]
  }
],
  "background": {
    "service_worker": "background.js"
  }
  
}
